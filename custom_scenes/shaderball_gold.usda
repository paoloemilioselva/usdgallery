#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    endTimeCode = 3
    framesPerSecond = 24
    metersPerUnit = 0.01
    startTimeCode = 3
    subLayers = [
        @full_assets/StandardShaderBall/standard_shader_ball_scene.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "standard_shader_ball_scene" (
    variants = {
        string example_material = "mtlx_gold"
    }
)
{
    over "materials"
    {
        over "neutral"
        {
            over "mtlx"
            {
                over "open_pbr_surface1"
                {
                    color3f inputs:base_color.connect = </standard_shader_ball_scene/materials/neutral/mtlx/mtlximage1.outputs:out>
                }
            }
        }
    }
}
